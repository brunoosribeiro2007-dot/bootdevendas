# ==============================================================================
# CONFIGURAÇÕES DO SERVIDOR & BANCO DE DADOS
# ==============================================================================
PORT=3000
NODE_ENV=production
# URL do PostgreSQL (ex: Supabase Pooler) ou utilize SQLite localmente
DATABASE_URL=
DB_PATH=./database.sqlite

# ==============================================================================
# CONFIGURAÇÕES DO WHATSAPP (BAILEYS)
# ==============================================================================
# Canal do WhatsApp (prioritário se preenchido - pode ser o nome "OfertaLar", link "https://whatsapp.com/channel/..." ou JID "...@newsletter")
WHATSAPP_TARGET_CHANNEL="OfertaLar"
# Nome exato do grupo do WhatsApp de ofertas (ou link/JID de grupo/canal)
WHATSAPP_TARGET_GROUP="OfertaLar"
# Número de destino para testes individuais (com DDI e DDD)
WHATSAPP_TARGET_NUMBER=5569984520192
# (Opcional) URL para Webhook ou API externa do WhatsApp se aplicável
WHATSAPP_API_URL=

# ==============================================================================
# PROGRAMA DE AFILIADOS DO MERCADO LIVRE
# ==============================================================================
# Sua tag oficial de afiliado
ML_AFFILIATE_TAG=bv20260330080614
# Ativar criação de link oficial encurtado (meli.la)
ML_USE_AFFILIATE_API=true
ML_AFFILIATE_API_URL=https://www.mercadolivre.com.br/affiliate-program/api/v2/affiliates/createLink
# String de cookies da sua conta de afiliado logada no Mercado Livre
ML_COOKIE_STRING=
# Caminho alternativo para cookies exportados (.ml_cookies.json)
ML_COOKIES_PATH=./.ml_cookies.json

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL GEMINI (CHAMADAS CRIATIVAS DE ALTA CONVERSÃO)
# ==============================================================================
# Chave de API do Google Gemini (obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=

# ==============================================================================
# PERSONALIZAÇÃO VISUAL (MARCA D'ÁGUA E TEMPLATE)
# ==============================================================================
# Caminho personalizado para a imagem de marca d'água (padrão: assets/watermark.png)
WATERMARK_PATH=assets/watermark.png
# Nome exibido no template acima do link de afiliado
DEFAULT_STORE_NAME="Oferta no Mercado Livre"

# ==============================================================================
# HORÁRIO DE ENVIO E AGENDAMENTOS (FUSO DE PORTO VELHO / RONDÔNIA)
# ==============================================================================
PUBLISH_START_TIME=08:00
PUBLISH_END_TIME=22:00
CRON_CAPTURE_SCHEDULE="*/10 * * * *"
CRON_PUBLISH_SCHEDULE="*/5 * * * *"

# ==============================================================================
# FILTRO DE PALAVRAS-CHAVE DO NICHO
# ==============================================================================
ML_SEARCH_KEYWORD="geladeira, cooktop, fogão, forno elétrico, micro-ondas, air fryer, liquidificador, batedeira, cafeteira, purificador de água, jogo de panelas, panela de pressão elétrica, smart tv, soundbar, ventilador, ar-condicionado, máquina de lavar, aspirador pó robô, ferro de passar, adega de vinhos, cervejeira"
ML_CATEGORY=
HISTORY_PRUNE_DAYS=3

# ==============================================================================
# SHOPEE (OPCIONAL)
# ==============================================================================
USE_SHOPEE=false
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_AFFILIATE_TAG=

# ==============================================================================
# AUTENTICAÇÃO DO PAINEL WEB (DASHBOARD)
# ==============================================================================
ADMIN_USER=admin
ADMIN_PASS=admin123
SESSION_SECRET=coloque_uma_chave_secreta_aleatoria_aqui
